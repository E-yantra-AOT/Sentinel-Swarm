    </plugin>
  </gazebo>



  <gazebo>
    <plugin filename="libgz-sim-multicopter-control-system.so"
            name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>__DRONE_ID__</robotNamespace>
      <commandSubTopic>gazebo/command/twist</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>6.0 6.0 10.0</velocityGain>
      <attitudeGain>0.2 0.2 0.02</attitudeGain>
      <angularRateGain>0.05 0.05 0.02</angularRateGain>
      <maximumLinearAcceleration>15 15 15</maximumLinearAcceleration>
      <maximumLinearVelocity>5 5 5</maximumLinearVelocity>
      <maximumAngularVelocity>3 3 3</maximumAngularVelocity>
      <rotorConfiguration>
        <rotor>
          <jointName>joint_prop_fl</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>joint_prop_fr</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>joint_prop_rl</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>joint_prop_rr</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>
  
    <!-- Publish ground truth pose for simulation feedback -->
    <plugin filename="libgz-sim-pose-publisher-system.so"
            name="gz::sim::systems::PosePublisher">
      <update_frequency>20</update_frequency>
      <!-- Avoid PosePublisher's dynamic-joint cache; the flight bridge only
           consumes this model's world pose, not propeller/joint transforms. -->
      <static_publisher>false</static_publisher>
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
    </plugin>
  </gazebo>
</robot>
